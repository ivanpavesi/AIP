# La homepage si avvia senza database e senza chiave.
AIP_ENVIRONMENT=development
# URL PostgreSQL locale o, in futuro, Supabase: non inserire credenziali qui.
AIP_DATABASE_URL=
# Una chiave Fernet generata localmente, mai condivisa o aggiunta a Git.
AIP_ENCRYPTION_KEY=
AIP_ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]"]
